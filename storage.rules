rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Prescription PDFs ─────────────────────────────────────────────────
    // Private by default. Access via signed URLs only (generated by backend).
    // Backend uses Admin SDK to upload (bypasses rules).
    match /prescriptions/{consultationId}/{fileName} {
      allow read: if false;   // Access via signed URL only
      allow write: if false;  // Backend Admin SDK only
    }

    // ─── Consultation Audio Chunks ────────────────────────────────────────
    // Uploaded by authenticated doctors via the dashboard.
    // Read by backend Admin SDK for transcription.
    match /consultations/{consultationId}/{fileName} {
      // Allow authenticated users to upload audio chunks
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024  // Max 10MB per chunk
        && (request.resource.contentType.matches('audio/.*')
            || request.resource.contentType.matches('application/octet-stream'));
      // Read by backend only (Admin SDK bypasses rules)
      allow read: if false;
    }

    // ─── Default deny ─────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
