# ==============================================================================
# VaidyaAI Backend Environment Configuration Template
# Target Project: vaidyaai-xprize | Region: asia-south1
# ==============================================================================

# Application Environment
ENVIRONMENT=production
PROJECT_NAME="VaidyaAI Agents API"
VERSION=1.0.0

# Google Cloud Platform Infrastructure
GOOGLE_CLOUD_PROJECT=vaidyaai-xprize
GCP_REGION=asia-south1
GCS_BUCKET_CONSULTATIONS=vaidyaai-xprize-consultations
GOOGLE_GENAI_USE_VERTEXAI=true

# Firebase & Firestore Configuration
FIREBASE_PROJECT_ID=vaidyaai-xprize

# Cloud SQL PostgreSQL Database Connection URL
# Production Cloud SQL (IAM / Auth Proxy): postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:5432/<DB>
# Local SQLite Dev Fallback: sqlite+aiosqlite:///./test.db
DATABASE_URL=sqlite+aiosqlite:///./test.db

# Cloud Tasks Queues Configuration
CLOUD_TASKS_LOCATION=asia-south1
CLOUD_TASKS_QUEUE_REMINDERS=appointment-reminders
CLOUD_TASKS_QUEUE_BILLING=billing-followups
CLOUD_TASKS_QUEUE_RETENTION=retention-outreach

# Backend Cloud Run Service Public URL
BACKEND_URL=https://vaidyaai-backend-placeholder.run.app

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# ==============================================================================
# SECRETS (POPULATE IN GCP SECRET MANAGER OR SECURE PRODUCTION ENV)
# ==============================================================================

# Meta WhatsApp Cloud API Secrets
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Razorpay Payments Secrets
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
