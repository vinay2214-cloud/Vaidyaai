rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Prescription PDFs ─────────────────────────────────────────────────
    // Private by default. Access via signed URLs only (generated by backend).
    // Backend uses Admin SDK to upload (bypasses rules).
    match /prescriptions/{consultationId}/{fileName} {
      allow read: if false;   // Access via signed URL only
      allow write: if false;  // Backend Admin SDK only
    }

    // ─── Consultation Audio Chunks ────────────────────────────────────────
    // Uploaded by authenticated doctors through the backend API
    // (POST /api/v1/consultations/upload-chunk), which enforces
    // verify_clinic_access() and writes via the Admin SDK. Direct client
    // writes are denied to prevent cross-tenant uploads to another clinic's
    // consultation path. Read by backend Admin SDK for transcription.
    match /consultations/{consultationId}/{fileName} {
      allow write: if false;  // Backend Admin SDK only (tenant-scoped via API)
      allow read: if false;   // Backend Admin SDK only
    }

    // ─── Default deny ─────────────────────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
