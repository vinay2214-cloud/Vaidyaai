# ==============================================================================
# VaidyaAI Frontend Environment Configuration Template
# Target Project: vaidyaai-xprize
# ==============================================================================

# Backend API Public Base URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Feature Flag: Development Authentication Bypass
# Set to "true" in local development to bypass SMS & Firebase Phone Auth
# STRICTLY ignored in production builds (NODE_ENV=production)
NEXT_PUBLIC_DEV_AUTH_BYPASS=false

# Firebase Web App Client Configuration (Public Key Info - SAFE FOR BROWSER)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vaidyaai-xprize.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vaidyaai-xprize
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vaidyaai-xprize.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Emulator Support (Set to "true" for local offline testing with Firebase Emulators)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=http://127.0.0.1:9099
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1
NEXT_PUBLIC_FIREBASE_FIRESTORE_EMULATOR_PORT=8181
